#!/bin/sh
set -eu

: "${CREDENTIALS_DIRECTORY:?systemd credential directory is unavailable}"
credential_path="${CREDENTIALS_DIRECTORY}/api-key"
if [ ! -f "${credential_path}" ] || [ ! -r "${credential_path}" ]; then
    printf '%s\n' 'CraneSched-Codex API credential is unavailable' >&2
    exit 1
fi

# The shell opens the systemd credential directly as stdin, then disappears.
# It never reads the credential into a variable or exposes it in argv/env.
exec /usr/libexec/cranesched-codex/codex responses-api-proxy "$@" <"${credential_path}"
